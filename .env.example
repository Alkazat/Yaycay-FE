# Yaycay FE environment. Copy to .env.local and fill in.
# All client-exposed values are prefixed NEXT_PUBLIC_.

# Supabase (anon key + URL from BE / infra)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Back-end API base URL (the @yaycay/contracts host).
# Leave EMPTY to use the in-repo mock contract (local /api/* route handlers).
# Set it once the real BE contract is published to call the live API instead.
NEXT_PUBLIC_API_BASE=

# Stripe publishable key (Checkout is opened from sessions created by BE)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# This app's own public origin, e.g. https://app.yaycay.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000
