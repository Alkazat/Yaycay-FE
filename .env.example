# Yaycay FE environment. Copy to .env.local and fill in.
# All client-exposed values are prefixed NEXT_PUBLIC_.
#
# Leave NEXT_PUBLIC_API_BASE EMPTY to run entirely on the in-repo mock
# (local /api/* route handlers). Set the three live values below to switch the
# served endpoints (demo, signup, trips, plan-chat, 2fa) to the real BE; the
# still-deferred endpoints stay on the mock until BE ships them.

# Supabase project URL + anon key (the anon key is a public browser key).
#   Staging:    https://srpipqrxggmfeagomvnk.supabase.co
#   Production: https://nzmjkbjtcjthjwdscjrj.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Back-end API base = the Supabase Edge Functions root.
#   Staging:    https://srpipqrxggmfeagomvnk.supabase.co/functions/v1
#   Production: https://nzmjkbjtcjthjwdscjrj.supabase.co/functions/v1
NEXT_PUBLIC_API_BASE=

# Stripe publishable key (Checkout is opened from sessions created by BE)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# This app's own public origin, e.g. https://app.yaycay.ai
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only (never NEXT_PUBLIC); read by the MCP connector ---------------
# Optional live "what's nearby" provider for the connector's whats_nearby tool.
# Leave PLACES_API_KEY EMPTY to use Yaycay's curated picks + the assistant's own
# area knowledge only (the default). Set a key to layer in real, current places.
#   PLACES_PROVIDER: "google" (default) or "foursquare".
PLACES_PROVIDER=
PLACES_API_KEY=
