# The Yaycay back-end contract is published to GitHub Packages under the
# @alkazat scope. This maps that scope to the right registry and supplies auth
# (a read:packages token) at install time via the NODE_AUTH_TOKEN env var -
# never commit a token here.
#
# Local:  export NODE_AUTH_TOKEN=ghp_xxx
# CI:     set NODE_AUTH_TOKEN (the Actions GITHUB_TOKEN with packages:read)
# Vercel: set NODE_AUTH_TOKEN to a PAT with read:packages
@alkazat:registry=https://npm.pkg.github.com
//npm.pkg.github.com/:_authToken=${NODE_AUTH_TOKEN}
